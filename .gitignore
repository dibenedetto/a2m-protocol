__pycache__/
*.py[cod]
.venv/
.env

# The project has no runtime dependencies, so the lock file only ever pins the
# optional extras. Committing it would list ollama, httpx and pydantic in a
# repository whose point is that it needs none of them.
uv.lock

# Build artifacts
dist/

# Sample-store artifacts
*.db
*.db-wal
*.db-shm
*.procedural/
memories/
demo-memories/

# Claude Code: shared settings are committed, personal ones are not
.claude/settings.local.json

# Rendered site. Built by www/render.py and published by the pages workflow;
# committing it would let a published page drift from the Markdown it came from.
www/public/
